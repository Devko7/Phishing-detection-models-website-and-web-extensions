{
  "manifest_version": 3,
  "name": "URL Phishing Detector",
  "version": "1.0",
  "description": "AI URL Phishing Detector",
  "icons": {},
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "permissions": [
    "webNavigation",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "block.html",
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}